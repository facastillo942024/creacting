# ---- Servidor ----
PORT=5000
# Origen(es) permitido(s) por CORS separados por coma. Ej: http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ---- Base de datos MySQL / MariaDB ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=creating

# ---- Autenticacion ----
# Cambiar por una cadena larga y aleatoria en produccion
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# ---- Uploads ----
# Carpeta (relativa a server/) donde se guardan las fotos comprimidas
UPLOAD_DIR=uploads
# Ancho maximo al redimensionar (px). La altura se ajusta proporcional.
IMAGE_MAX_WIDTH=1000
# Calidad WebP (1-100)
IMAGE_QUALITY=78
# Tamano maximo de subida en MB (antes de comprimir)
MAX_UPLOAD_MB=10
