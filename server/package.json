{
  "name": "creacting-server",
  "version": "1.0.0",
  "description": "Backend API de CreactingCinema: plataforma de actores/talento con roles y busqueda flexible",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:schema": "node scripts/run-sql.js db/schema.sql",
    "db:seed": "node scripts/run-sql.js db/seed.sql",
    "db:setup": "node scripts/run-sql.js db/schema.sql && node scripts/run-sql.js db/seed.sql"
  },
  "keywords": [
    "actores",
    "casting",
    "express",
    "api"
  ],
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "sharp": "^0.33.4"
  }
}
